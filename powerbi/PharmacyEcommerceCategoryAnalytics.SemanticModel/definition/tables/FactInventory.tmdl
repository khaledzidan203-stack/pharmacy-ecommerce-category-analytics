	partition FactInventory = m
		mode: import
		source = Value.NativeQuery(Sql.Database(".\SQLEXPRESS", "PharmacyEcommerceCategoryAnalytics"), "SELECT * FROM [analytics].[vw_inventory_risk]", null, [EnableFolding=true])
