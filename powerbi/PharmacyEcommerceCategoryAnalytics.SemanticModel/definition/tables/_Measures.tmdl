table _Measures
	lineageTag: 7c8d9e0f-1a2b-4c3d-8e5f-60718293a4b5

	measure 'Net Sales' = SUM('analytics vw_sales_enriched'[net_sales])
		formatString: #,##0.00;(#,##0.00);-
		displayFolder: Commercial
		lineageTag: ac17aa31-f556-41a1-897e-922a11c454b1

	measure 'Gross Margin' = SUM('analytics vw_sales_enriched'[gross_margin])
		formatString: #,##0.00;(#,##0.00);-
		displayFolder: Commercial
		lineageTag: 96684826-f924-443b-99c6-90d4827f6b8e

	measure 'Margin %' = DIVIDE([Gross Margin], [Net Sales])
		formatString: 0.00%
		displayFolder: Commercial
		lineageTag: df28e3ad-40bc-43db-92b1-73e5456416ce

	measure 'Units Sold' = SUM('analytics vw_sales_enriched'[units_sold])
		formatString: #,##0
		displayFolder: Core
		lineageTag: e05bd2c9-dc14-4a5f-86d4-798e46352188

	measure Orders = SUM('analytics vw_sales_enriched'[orders])
		formatString: #,##0
		displayFolder: Core
		lineageTag: d57aa62b-4417-4e30-9a99-677abeaf2dee

	measure Customers = SUM('analytics vw_sales_enriched'[customers])
		formatString: #,##0
		displayFolder: Core
		lineageTag: 4ab4d8e6-e842-4508-b260-03abb86341dd

	measure 'Average Order Value' = DIVIDE([Net Sales], [Orders])
		formatString: #,##0.00;(#,##0.00);-
		displayFolder: Commercial
		lineageTag: 24b5ebb2-6b48-424d-8516-60a6e5dff2e0

	measure 'E-commerce Sales' = CALCULATE([Net Sales], 'analytics vw_sales_enriched'[channel] = "E-commerce")
		formatString: #,##0.00;(#,##0.00);-
		displayFolder: E-commerce
		lineageTag: 07f23358-f135-46d3-947f-330bce4f64aa

	measure 'E-commerce Sales Mix' = DIVIDE([E-commerce Sales], [Net Sales])
		formatString: 0.00%
		displayFolder: E-commerce
		lineageTag: 67ed6b34-4dee-47f6-a10e-322f9e31ffe9

	measure 'PDP Views' = SUM('analytics vw_ecommerce_funnel'[pdp_views])
		formatString: #,##0
		displayFolder: E-commerce
		lineageTag: 144396f0-42c0-4375-b619-17694a6edebc

	measure 'Add to Cart' = SUM('analytics vw_ecommerce_funnel'[add_to_cart])
		formatString: #,##0
		displayFolder: E-commerce
		lineageTag: 6b8f19e9-3fdd-4529-b5a3-7e915ff326dc

	measure 'Online Orders' = SUM('analytics vw_ecommerce_funnel'[online_orders])
		formatString: #,##0
		displayFolder: E-commerce
		lineageTag: d432994a-c416-4bb9-9c09-62dae52c50ce

	measure 'Conversion Rate' = DIVIDE([Online Orders], [PDP Views])
		formatString: 0.00%
		displayFolder: E-commerce
		lineageTag: 5aa4d8b2-9e2f-47fc-b239-eb3de64617ec

	measure 'Add-to-Cart Rate' = DIVIDE([Add to Cart], [PDP Views])
		formatString: 0.00%
		displayFolder: E-commerce
		lineageTag: 957a2c79-5757-4050-a777-d7daba73bffe

	measure 'Stock Cost' = SUM('analytics vw_inventory_risk'[stock_cost])
		formatString: #,##0.00;(#,##0.00);-
		displayFolder: Inventory
		lineageTag: 8a70aa22-bd47-4545-986d-427472929116

	measure 'Near Expiry Units' = SUMX(FILTER('analytics vw_inventory_risk', 'analytics vw_inventory_risk'[near_expiry_flag] = 1), 'analytics vw_inventory_risk'[stock_units])
		formatString: #,##0
		displayFolder: Inventory
		lineageTag: 7e44dd19-4fc3-4c77-b0b1-a3cde2a5c91b

	measure 'Dead Stock Units' = SUMX(FILTER('analytics vw_inventory_risk', 'analytics vw_inventory_risk'[dead_stock_flag] = 1), 'analytics vw_inventory_risk'[stock_units])
		formatString: #,##0
		displayFolder: Inventory
		lineageTag: 6fe085b9-06a2-480e-b982-22c21c833c36

	measure 'Average Days of Coverage' = AVERAGE('analytics vw_inventory_risk'[days_of_coverage])
		formatString: #,##0.0
		displayFolder: Inventory
		lineageTag: 83049538-3540-457d-a767-742a250ac7df

	measure 'Supplier Fill Rate' = DIVIDE(SUM('analytics vw_supplier_performance'[received_qty]), SUM('analytics vw_supplier_performance'[ordered_qty]))
		formatString: 0.00%
		displayFolder: Supplier
		lineageTag: 051e0eea-c558-4d6f-b454-f0e6fb3dc380

	measure 'Average Lead Time' = AVERAGE('analytics vw_supplier_performance'[actual_lead_time_days])
		formatString: #,##0.0
		displayFolder: Supplier
		lineageTag: 8652513f-9177-4b5c-b0b3-c09ac773276b

	measure 'Promo Sales Mix' = DIVIDE(CALCULATE([Net Sales], 'analytics vw_sales_enriched'[promotion_id] <> 0), [Net Sales])
		formatString: 0.00%
		displayFolder: Commercial
		lineageTag: b4a9abd9-a106-4b25-a835-927c2286cb30

	measure 'Ordered Quantity' = SUM('analytics vw_supplier_performance'[ordered_qty])
		formatString: #,##0
		displayFolder: Supplier
		lineageTag: 1eb28851-531d-4d88-b397-b2a1b3b3dfac

	column 'Measure Group'
		isHidden
		lineageTag: 7c8d9e0f-1a2b-4c3d-8e5f-60718293a4b6
		summarizeBy: none
		isNameInferred
		sourceColumn: [Measure Group]

	partition _Measures = calculated
		mode: import
		source = DATATABLE("Measure Group", STRING, {{"Pharmacy E-commerce Measures"}})

	annotation PBI_Id = 7c8d9e0f1a2b4c3d8e5f60718293a4b5

