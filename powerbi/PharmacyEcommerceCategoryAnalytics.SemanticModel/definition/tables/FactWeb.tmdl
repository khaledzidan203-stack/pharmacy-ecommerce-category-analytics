table FactWeb
	lineageTag: f5b6c7d8-e9f0-1122-3344-556677889900

	column activity_date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: activity_date
	column sku_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sku_id
	column product_detail_views
		dataType: int64
		summarizeBy: sum
		sourceColumn: product_detail_views
	column add_to_cart
		dataType: int64
		summarizeBy: sum
		sourceColumn: add_to_cart
	column online_orders
		dataType: int64
		summarizeBy: sum
		sourceColumn: online_orders

	partition FactWeb = m
		mode: import
		source = Value.NativeQuery(Sql.Database(".\SQLEXPRESS", "PharmacyEcommerceCategoryAnalytics"), "SELECT * FROM [staging].[fact_web_daily]", null, [EnableFolding=true])
